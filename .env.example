# FitMate deployment environment template

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=fitmate
MYSQL_USER=fitmate
MYSQL_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/fitmate?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=fitmate
SPRING_DATASOURCE_PASSWORD=change-me

# Redis / Mongo
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
REDIS_HOST=redis
REDIS_PORT=6379
MONGODB_URI=mongodb://mongo:27017/communication-server

# App URLs
SPRING_PROFILES_ACTIVE=prod
NODE_ENV=production
APP_FRONTEND_URL=https://www.fitmate.com
APP_BACKEND_URL=https://www.fitmate.com
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://www.fitmate.com
VITE_API_BASE_URL=
VITE_CHAT_SERVER_URL=
FRONTEND_URL=https://www.fitmate.com
CORS_ORIGINS=https://www.fitmate.com

# Auth cookies
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
VITE_ENABLE_CLIENT_LOGS=false

# JWT
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRATION=86400000

# Seed data
DATA_LOADER_ENABLED=false
DATA_LOADER_TEST_DATA_ENABLED=false
DATA_LOADER_TEST_PASSWORD=
DATA_LOADER_ADMIN_PASSWORD=
DATA_LOADER_DEMO_EMAIL=demo@fitmate.local

# Scheduler
SCHEDULER_ENABLED=true
NOTIFICATION_SCHEDULER_ENABLED=false

# OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Twilio / SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
